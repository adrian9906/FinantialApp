{
  "name": "plata-app-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "babel-preset-expo": "56.0.15"
    }
  },
  "scripts": {
    "android:fix-gradle": "node scripts/fix-capacitor-android-gradle.mjs",
    "postinstall": "node scripts/fix-capacitor-android-gradle.mjs",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api dev",
    "build:web": "pnpm --dir apps/web build",
    "build:api": "pnpm --dir apps/api build",
    "lint:web": "pnpm --dir apps/web lint",
    "db:generate": "pnpm --dir apps/api db:generate",
    "db:migrate": "pnpm --dir apps/api db:migrate",
    "db:push": "pnpm --dir apps/api db:push",
    "db:studio": "pnpm --dir apps/api db:studio",
    "test:sync": "tsx packages/shared/src/sync.test.mts",
    "test:date": "tsx apps/web/src/lib/date.test.mts",
    "test:income": "tsx packages/shared/src/income.test.mts",
    "test:income-money": "tsx apps/web/src/lib/income-money.test.mts",
    "test:income-account": "tsx apps/web/src/lib/income-account.test.mts",
    "test:receipt": "tsx apps/web/src/lib/receipt-review.test.mts",
    "test:attachments": "tsx packages/shared/src/attachments.test.mts",
    "test:payment": "tsx packages/shared/src/payment-method.test.mts",
    "test:monthly-overview": "tsx packages/shared/src/monthly-overview.test.mts",
    "test:currency": "tsx --tsconfig apps/web/tsconfig.app.json apps/web/src/lib/currency-registry.test.mts",
    "test:receipt-account": "tsx --tsconfig apps/web/tsconfig.app.json apps/web/src/lib/receipt-account.test.mts",
    "test:account-savings": "tsx --tsconfig apps/web/tsconfig.app.json apps/web/src/lib/account-savings.test.mts",
    "test:account-savings-flow": "tsx --tsconfig apps/web/tsconfig.app.json apps/web/src/lib/account-savings-flow.test.mts",
    "test:account-savings-prefs": "tsx apps/api/src/account-savings-preferences.test.mts",
    "test:google": "tsx apps/api/src/google-auth.test.mts"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.3"
  }
}
