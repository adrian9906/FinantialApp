# PostgreSQL de la API: rol de aplicación con permisos mínimos.
DATABASE_URL="postgresql://plata_app:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/plata?schema=public"
# Prisma CLI para migraciones y recuperación. Nunca expongas estas variables al frontend.
DIRECT_URL="postgresql://plata_migrator:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/plata?schema=public"
SESSION_SECRET="genera-un-secreto-largo-y-aleatorio"
APP_URL="https://tu-dominio.example"
CORS_ALLOWED_ORIGINS="https://tu-dominio.example"

# Google sign-in. Without these the /api/auth/google endpoint returns 503 and
# the button stays hidden, so the app keeps working with email + password.
# Web client id (Google Cloud Console > Credentials > OAuth 2.0, type "Web").
GOOGLE_CLIENT_ID=
# Android/iOS client ids, used by the Capacitor build. Optional.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
