# Google sign-in. Without these the /api/auth/google endpoint returns 503 and
# the button stays hidden, so the app keeps working with email + password.
# Web client id (Google Cloud Console > Credentials > OAuth 2.0, type "Web").
GOOGLE_CLIENT_ID=
# Android/iOS client ids, used by the Capacitor build. Optional.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
