# Mismo client ID web que la API. Si se omite, el cliente lo obtiene de la API.
# Si se define, Vite lo incrusta durante el build.
VITE_GOOGLE_CLIENT_ID=

# URL publica de la API, sin /api ni barra final.
# En desarrollo puede omitirse: Vite usa http://localhost:3001 mediante el proxy.
VITE_API_BASE_URL=
